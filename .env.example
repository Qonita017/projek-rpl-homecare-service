# HomeCare Service - Environment Variables Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=homecare_db

# AI API Configuration
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Telegram Client API / MTProto (Userbot) Configuration
# Dapatkan API_ID & API_HASH dari https://my.telegram.org (Menu API development tools)
# Jalankan 'python telegram_userbot/auth_session.py' untuk menghasilkan TELEGRAM_SESSION_STRING otomatis.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_ADMIN_PHONE=
PYTHON_BIN_PATH=python

# Fonnte WhatsApp API
# Token digunakan HANYA di server-side (FonnteService.php) — tidak boleh dikirim ke browser.
# Dapatkan/perbarui token di: https://fonnte.com/dashboard
FONNTE_API_TOKEN=isi_token_fonnte_di_sini
